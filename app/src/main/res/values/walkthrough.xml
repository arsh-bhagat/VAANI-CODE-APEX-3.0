    <string name="tour_choose_feature">Learn about a feature</string>
    <string name="feature_navigation_title">Find your way around</string>
    <string name="feature_navigation_body">Use the tabs to reach Armed, Vault, Community, Support and Settings.</string>
    <string name="feature_safeword_title">Safeword protection</string>
    <string name="feature_safeword_body">Choose your trigger phrase and enable recognition while the app is open in the foreground. Offline recognition depends on your device.</string>
    <string name="feature_alert_title">Record and alert</string>
    <string name="feature_alert_body">Hold the alert control for two seconds to record audio. Configured trusted contacts can receive one SMS when permission is granted. Stop and seal encrypts the evidence on this device.</string>
    <string name="feature_contacts_title">Trusted contacts</string>
    <string name="feature_contacts_body">Add the people you want to alert in Settings. Emergency SMS goes only to configured contacts when SMS permission is granted.</string>
    <string name="feature_vault_title">Encrypted evidence vault</string>
    <string name="feature_vault_body">Evidence is encrypted on this device. Authenticate with your device security to view recordings or export a chain-of-custody record. No cloud or peer sync is connected.</string>
    <string name="feature_camera_title">Photo and video evidence</string>
    <string name="feature_camera_body">Capture a private photo or a silent video up to 60 seconds, or import an image or video. Each item is encrypted and added to the evidence chain.</string>
    <string name="feature_map_title">Community map</string>
    <string name="feature_map_body">Explore sample danger zones and route previews. These are not live safety reports or a safety guarantee. Map tiles need internet access; check local conditions.</string>
    <string name="feature_support_title">Support resources</string>
    <string name="feature_support_body">Find public support resources and official links here. Phone actions open your dialer so you remain in control.</string>
    <string name="feature_decoy_title">Decoy call</string>
    <string name="feature_decoy_body">Show a simulated incoming-call screen now or after a delay. It rings locally but does not place a real call or play a voice conversation.</string>
    <string name="feature_disguise_title">Notes disguise</string>
    <string name="feature_disguise_body">Disguise changes the launcher and opens All Notes on future launches. To return to VAANI, hold the %1$s header for two seconds, or enter ##, vaani, or 911 in the Notes search field. Lock to Notes hides the safety interface immediately.</string>
    <string name="feature_replay_title">Replay the walkthrough</string>
    <string name="feature_replay_body">Return to Help &amp; onboarding in Settings to replay this tour anytime. Feature help also lets you review individual explanations.</string>
    <string name="feature_gesture_title">Deliberate shake wake</string>
    <string name="feature_gesture_body">In Gesture-Wake mode, a deliberate back-and-forth shake opens a listening window for up to 12 seconds. Ordinary handling should not wake it. Gesture detection works only while VAANI or Notes is open in the foreground.</string>
    <string name="feature_location_title">Location protection</string>
    <string name="feature_location_body">Track while armed keeps a timestamped last known location ready for emergency SMS. Android shows an ongoing notification while tracking is active.</string>
    <string name="feature_security_title">Device and vault security</string>
    <string name="feature_security_body">The vault uses your fingerprint, face, or device screen lock and locks when the app leaves the foreground. Set up device security to access sealed evidence.</string>
    <string name="feature_dispatch_title">Emergency dispatch</string>
    <string name="feature_dispatch_body">Trusted-contact SMS works when configured and permitted. Police, NGO, peer and shelter panels are previews until an approved integration is connected.</string>
    <string name="feature_integrity_title">Verify chain integrity</string>
    <string name="feature_integrity_body">After unlocking the vault, verify the hashes of sealed evidence and its chain. Verification flags mismatches; it does not prove that a recording describes a real event.</string>
    <string name="feature_blackout_title">Blackout display</string>
    <string name="feature_blackout_body">Blackout covers the vault with a dark screen. Use Return to vault to leave it. It does not stop an ongoing recording.</string>
